%!
% Ferrokit: the PDF/A output intent for Ghostscript's pdfwrite (sRGB).
% Used as: gs -dPDFA=2 ... --permit-file-read=/usr/share/color/icc/ghostscript/ PDFA_def.ps input.pdf
/ICCProfile (/usr/share/color/icc/ghostscript/srgb.icc) def
[/_objdef {icc_PDFA} /type /stream /OBJ pdfmark
[{icc_PDFA} << /N 3 >> /PUT pdfmark
[{icc_PDFA} ICCProfile (r) file /PUT pdfmark
[/_objdef {OutputIntent_PDFA} /type /dict /OBJ pdfmark
[{OutputIntent_PDFA} <<
  /Type /OutputIntent
  /S /GTS_PDFA1
  /DestOutputProfile {icc_PDFA}
  /OutputConditionIdentifier (sRGB)
>> /PUT pdfmark
[{Catalog} << /OutputIntents [ {OutputIntent_PDFA} ] >> /PUT pdfmark
